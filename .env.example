# Neon Postgres connection string (serverless Postgres)
# Create a project at https://console.neon.tech → Connection Details
# Prefer "Pooled connection" for serverless/Node to avoid connection exhaustion
DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT secret for signing auth tokens (use a random string in production)
JWT_SECRET=change-me-to-a-random-secret-string
